@{
    ViewData["Title"] = "Page Not Found";
}

<div class="hero">
    <h1>404 - Page Not Found</h1>
    <p>The page you are looking for does not exist or has been moved.</p>
</div>

<div class="search-card" style="text-align: center;">
    <div class="error-card" style="justify-content: center; border-left: none; border-top: 5px solid var(--primary-color);">
        <span>🔎</span>
        <p>We couldn't find what you were looking for. Please check the URL or return to the search portal.</p>
    </div>
    <a href="/" class="btn btn-primary" style="margin-top: 2rem;">Return to Search Portal</a>
</div>
