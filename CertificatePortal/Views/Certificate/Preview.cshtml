@model CertificatePortal.Models.ViewModels.CertificateViewModel
@using Microsoft.Extensions.Options
@inject IOptions<CertificatePortal.Models.AppSettings> Settings
@{
    ViewData["Title"] = "Preview Certificate";
    var s = Settings.Value;
    var qrUrl = $"https://auca.ac.rw/verify/{Model.Record.StudentID}";
    var qrGenerator = new QRCoder.QRCodeGenerator();
    var qrData = qrGenerator.CreateQrCode(qrUrl, QRCoder.QRCodeGenerator.ECCLevel.Q);
    var qrCode = new QRCoder.PngByteQRCode(qrData);
    var qrBase64 = Convert.ToBase64String(qrCode.GetGraphic(5));
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Pinyon+Script&display=swap');
    @@font-face { font-family: 'Edwardian Script ITC'; src: local('Edwardian Script ITC'), local('EdwardianScriptITC'); }
    .preview-container { max-width: 950px; margin: 0 auto; }
    .preview-actions { display: flex; justify-content: space-between; margin-bottom: 1.5rem; }
    .certificate-card {
        background: white; padding: 1.5cm 2.2cm; box-shadow: 0 10px 30px rgba(0,0,0,0.1); border: 1px solid #ddd;
        font-family: 'Times New Roman', Times, serif; color: black; position: relative; min-height: 297mm;
        display: flex; flex-direction: column; box-sizing: border-box; line-height: 1.2;
    }
    .header-table { width: 100%; border-bottom: 2.5px solid #000; padding-bottom: 8px; margin-bottom: 15px; border-collapse: collapse; }
    .logo-cell { width: 95px; vertical-align: middle; text-align: left; }
    .cert-logo { width: 90px; height: auto; }
    .header-text-cell { vertical-align: middle; text-align: left; padding-left: 15px; }
    .uni-title { font-size: 16pt; margin: 0; font-weight: 500; color: #003399; }
    .header-p { margin: 1px 0; font-size: 9pt; }
    .dept-line { font-family: 'Edwardian Script ITC', 'Pinyon Script', cursive; font-size: 22pt !important; margin: 2px 0 !important; font-weight: bold; color: black; line-height: 0.8; text-align: center; }
    .email-link { color: blue; text-decoration: underline; }
    .black-text { color: black; font-weight: normal; }
    .cert-date { text-align: left; margin-bottom: 15px; font-size: 12pt; font-weight: normal; }

    .cert-title { text-align: center; margin: 20px 0; font-size: 13.5pt; font-weight: bold; text-transform: uppercase; }
    .cert-body { font-size: 12pt; line-height: 1.5; text-align: justify; }
    .student-details { margin: 10px 0; }
    .student-name { font-size: 14pt; font-weight: bold; margin-bottom: 5px; }
    .field-label { font-weight: normal; }
    .field-value { font-weight: bold; }
    .no-wrap { white-space: nowrap; }
    .cert-footer { margin-top: 40px; display: flex; flex-direction: column; padding-bottom: 0.5cm; }
    .footer-table { width: 100%; border-collapse: collapse; }
    .footer-cell-left { width: 60%; vertical-align: bottom; text-align: left; }
    .footer-cell-right { width: 40%; vertical-align: bottom; text-align: right; }
    .sig-image { width: 165px; height: auto; margin-bottom: -5px; display: block; }
    .sig-line { border-top: 1.5px solid black; width: 330px; margin: 5px 0; }
    .director-info { text-align: left; line-height: 1.4; font-size: 1.15rem; }
    .sig-name { font-weight: bold; }
    .qr-image { width: 105px; height: 105px; display: block; margin-left: auto; }
    .verify-text { font-size: 0.9rem; margin-top: 5px; text-align: center; width: 105px; float: right; }
    .btn { padding: 0.8rem 1.5rem; border-radius: 4px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; }
    .btn-outline { border: 2px solid var(--primary-color); color: var(--primary-color); background: white; }
    .btn-gold { background-color: var(--accent-color); color: var(--primary-color); }
    @@media print {
        header, footer, .preview-actions, .no-print { display: none !important; }
        body { background: white !important; margin: 0 !important; padding: 0 !important; }
        main { margin: 0 !important; padding: 0 !important; max-width: 100% !important; }
        .certificate-card { box-shadow: none !important; border: none !important; padding: 1.5cm 2.2cm !important; width: 210mm !important; height: 297mm !important; margin: 0 auto !important; page-break-after: always; overflow: hidden; }
    }
</style>

<div class="preview-container">
    <div class="preview-actions no-print">
        <a href="/" class="btn btn-outline">← Back to Search</a>
        <div>
            <button onclick="window.print()" class="btn btn-outline">Print Preview</button>
            <a asp-action="DownloadPdf" asp-route-studentId="@Model.Record.StudentID" class="btn btn-gold">⬇ Download PDF</a>
        </div>
    </div>

    <div class="certificate-card">
        <table class="header-table">
            <tr>
                <td class="logo-cell"><img src="~/images/auca-logo.png" class="cert-logo" alt="AUCA Logo" /></td>
                <td class="header-text-cell">
                    <h2 class="uni-title">Adventist University of Central Africa</h2>
                    <p class="header-p">P.O. Box 2461 Kigali, Rwanda | www.auca.ac.rw | info@auca.ac.rw</p>
                    <p class="dept-line">Directorate for Admissions and Academic Records</p>
                    <p class="header-p" style="margin-top: 8px;">Mobile Phone : (+250) 724 796 996 / 724 474 805 / 788 473 035</p>
                    <p class="header-p"><span class="black-text">Email: </span><a class="email-link">registrar@auca.ac.rw</a> <span class="black-text"> || </span> <a class="email-link">juvenal.nsengiyumva@auca.ac.rw</a></p>
                </td>
            </tr>
        </table>
        <div class="cert-date">@Model.CityAndDate</div>
        <div class="cert-title">CERTIFICATE OF GOOD STANDING</div>
        <div class="cert-body">
            <p>I, the undersigned, Eng. Nsengiyumva Juvenal, Director for Admissions and Academic Records of the Adventist University of Central Africa, hereby certify that:</p>
            <div class="student-details">
                <div class="student-name">@Model.FormattedStudentName</div>
                <div>Born on <strong>@Model.FormattedBirthDate</strong>,</div>
                <div class="no-wrap">has been a regular student of this University, registered under <strong>ID No. @Model.Record.StudentID</strong>,</div>
                <div>From <strong>@Model.Record.StudiedFrom</strong> to <strong>@Model.Record.StudiedTo</strong>.</div>
            </div>
            <p style="margin: 4px 0;"><span class="field-label">Year:</span> <span class="field-value">@Model.Record.Year</span></p>
            <p style="margin: 4px 0;"><span class="field-label">Faculty:</span> <span class="field-value">@Model.Record.Faculty</span></p>
            <p style="margin: 4px 0;"><span class="field-label">Major:</span> <span class="field-value">@Model.Record.Major</span></p>
            <p style="margin: 4px 0;"><span class="field-label">Academic year:</span> <span class="field-value">@Model.Record.AcademicYear</span></p>
            <p style="margin: 4px 0;"><span class="field-label">Validity:</span> <span class="field-value">@Model.Record.AcademicYear</span></p>
            <p style="margin-top: 25px;">This certificate is issued for any legal or administrative purpose it may serve</p>
        </div>
        <div class="cert-footer">
            <table class="footer-table">
                <tr>
                    <td class="footer-cell-left">
                        <img src="~/images/signature.png" class="sig-image" alt="Signature" />
                        <div class="sig-line"></div>
                        <div class="director-info">
                            <div class="sig-name">Eng. Nsengiyumva Juvenal</div>
                            <div>Director for Admissions and Academic Records</div>
                            <div>Adventist University of Central Africa</div>
                        </div>
                    </td>
                    <td class="footer-cell-right">
                        <img src="data:image/png;base64,@qrBase64" class="qr-image" alt="QR Code" />
                        <div class="verify-text">Scan to verify my Validity</div>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>
