@model CertificatePortal.Models.ViewModels.CertificateViewModel
@using Microsoft.Extensions.Options
@inject IOptions<CertificatePortal.Models.AppSettings> Settings
@{
    ViewData["Title"] = "Preview Certificate";
    var s = Settings.Value;
    // Generate QR Code for Web Preview
    var qrUrl = $"https://auca.ac.rw/verify/{Model.Record.StudentID}";
    var qrGenerator = new QRCoder.QRCodeGenerator();
    var qrData = qrGenerator.CreateQrCode(qrUrl, QRCoder.QRCodeGenerator.ECCLevel.Q);
    var qrCode = new QRCoder.PngByteQRCode(qrData);
    var qrBase64 = Convert.ToBase64String(qrCode.GetGraphic(5));
}

<style>
    .preview-container {
        max-width: 900px;
        margin: 0 auto;
    }

    .preview-actions {
        display: flex;
        justify-content: space-between;
        margin-bottom: 2rem;
    }

    .certificate-card {
        background: white;
        padding: 4rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        border: 1px solid #ddd;
        font-family: 'Times New Roman', Times, serif;
        color: black;
        position: relative;
        min-height: 1050px;
    }

    .cert-header-table {
        width: 100%;
        border-bottom: 2px solid #000;
        padding-bottom: 1rem;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .cert-logo {
        width: 90px;
        height: auto;
    }

    .cert-header-text {
        flex: 1;
        text-align: center;
    }

    .cert-header-text h2 {
        font-family: 'Times New Roman', serif;
        font-size: 1.6rem;
        margin: 0;
        font-weight: bold;
        color: #003399;
    }

    .cert-header-text p {
        margin: 2px 0;
        font-size: 0.9rem;
    }

    .dept-line {
        font-family: 'Edwardian Script ITC', cursive;
        font-size: 2.2rem !important;
        margin-top: 4px !important;
        font-style: normal !important;
    }

    .email-link {
        color: blue;
        text-decoration: underline;
    }

    .cert-date {
        text-align: left;
        margin-bottom: 2rem;
        font-size: 1.1rem;
        font-weight: bold;
    }

    .cert-title {
        text-align: center;
        margin: 2.5rem 0;
    }

    .cert-title h1 {
        font-family: 'Times New Roman', serif;
        font-size: 1.8rem;
        text-decoration: none;
        font-weight: bold;
        color: black;
        text-transform: uppercase;
    }

    .cert-body {
        font-size: 1.15rem;
        line-height: 1.7;
        text-align: justify;
    }

    .student-details {
        margin: 1.5rem 0;
    }

    .student-name {
        font-size: 1.3rem;
        font-weight: bold;
        margin-bottom: 0.5rem;
    }

    .field-label {
        font-weight: normal;
    }

    .field-value {
        font-weight: bold;
    }

    .cert-footer {
        margin-top: 4rem;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    .qr-block {
        text-align: left;
    }

    .qr-image {
        width: 90px;
        height: 90px;
    }

    .signature-block {
        text-align: left;
        flex: 1;
        margin-left: 2rem;
    }

    .sig-image {
        width: 150px;
        height: auto;
        margin-bottom: -10px;
        float: right;
    }

    .footer-hr {
        border: none;
        border-top: 2px solid black;
        margin-bottom: 10px;
    }

    .sig-name {
        font-weight: bold;
    }

    .btn {
        padding: 0.8rem 1.5rem;
        border-radius: 4px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-outline {
        border: 2px solid var(--primary-color);
        color: var(--primary-color);
        background: white;
    }

    .btn-gold {
        background-color: var(--accent-color);
        color: var(--primary-color);
    }

    .no-wrap {
        white-space: nowrap;
    }

    @@media print {
        header, footer, .preview-actions, .no-print {
            display: none !important;
        }
        body {
            background: white !important;
            margin: 0 !important;
            padding: 0 !important;
        }
        main {
            margin: 0 !important;
            padding: 0 !important;
            max-width: 100% !important;
        }
        .certificate-card {
            box-shadow: none !important;
            border: none !important;
            padding: 2.5cm !important;
            width: 210mm !important;
            height: 297mm !important;
            min-height: 297mm !important;
            margin: 0 auto !important;
            page-break-after: always;
            box-sizing: border-box;
        }
    }
</style>

<div class="preview-container">
    <div class="preview-actions no-print">
        <a href="/" class="btn btn-outline">← Back to Search</a>
        <div>
            <button onclick="window.print()" class="btn btn-outline">Print Preview</button>
            <a asp-action="DownloadPdf" asp-route-studentId="@Model.Record.StudentID" class="btn btn-gold">⬇ Download PDF</a>
        </div>
    </div>

    <div class="certificate-card">
        <div class="cert-header-table">
            <img src="~/images/auca-logo.png" class="cert-logo" alt="AUCA Logo" />
            <div class="cert-header-text">
                <h2>Adventist University of Central Africa</h2>
                <p>P.O. Box 2461 Kigali, Rwanda | www.auca.ac.rw | info@auca.ac.rw</p>
                <p class="dept-line">Directorate for Admissions and Academic Records</p>
                <p>@Model.MobilePhoneLabel (+250)724 796 996 / 724 474 805/ 788 473 035</p>
                <p>
                    <a class="email-link">registrar@auca.ac.rw</a> || 
                    <a class="email-link">juvenal.nsengiyumva@auca.ac.rw</a>
                </p>
            </div>
        </div>

        <div class="cert-date">
            @Model.CityAndDate
        </div>

        <div class="cert-title">
            <h1>CERTIFICATE OF GOOD STANDING</h1>
        </div>

        <div class="cert-body">
            <p>I, the undersigned, <strong>Eng. Nsengiyumva Juvenal</strong>, <strong>Director for Admissions and Academic Records</strong> of the Adventist University of Central Africa, hereby certify that:</p>

            <div class="student-details">
                <div class="student-name">@Model.FormattedStudentName</div>
                <div>Born on <strong>@Model.FormattedBirthDate</strong>,</div>
                <div class="no-wrap">has been a regular student of this University, registered under <strong>ID No. @Model.Record.StudentID</strong>,</div>
                <div>From <strong>@Model.Record.StudiedFrom</strong> to <strong>@Model.Record.StudiedTo</strong>.</div>
            </div>

            <p style="margin: 2px 0;"><span class="field-label">Year:</span> <span class="field-value">@Model.Record.Year</span></p>
            <p style="margin: 2px 0;"><span class="field-label">Faculty:</span> <span class="field-value">@Model.Record.Faculty</span></p>
            <p style="margin: 2px 0;"><span class="field-label">Major:</span> <span class="field-value">@Model.Record.Major</span></p>
            <p style="margin: 2px 0;"><span class="field-label">Academic year:</span> <span class="field-value">@Model.Record.AcademicYear</span></p>
            <p style="margin: 2px 0;"><span class="field-label">Validity:</span> <span class="field-value">@Model.Record.AcademicYear</span></p>

            <p style="margin-top: 2rem; font-style: italic;">
                This certificate is issued for any legal or administrative purpose it may serve
            </p>
        </div>

        <div class="cert-footer">
            <div class="qr-block">
                <img src="data:image/png;base64,@qrBase64" class="qr-image" alt="QR Code" />
                <p style="font-size: 0.85rem; margin-top: 0.5rem;">Scan to verify my Validity</p>
            </div>

            <div class="signature-block">
                <img src="~/images/signature.png" class="sig-image" alt="Signature" />
                <div style="clear:both;"></div>
                <hr class="footer-hr" />
                <div class="sig-name">Eng. Nsengiyumva Juvenal</div>
                <div>Director for Admissions and Academic Records</div>
                <div>Adventist University of Central Africa</div>
            </div>
        </div>
    </div>
</div>
